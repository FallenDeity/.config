# Generic Git settings included from global ~/.gitconfig

[pull]
    ff = only

[diff]
    algorithm = histogram
    submodule = log
    tool = difftastic

[difftool]
    prompt = false

[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"

[pager]
    difftool = less -RFX

[alias]
    dft = difftool

[commit]
    verbose = true

[rerere]
    enabled = true

[help]
    autocorrect = prompt

[status]
    submoduleSummary = true

[submodule]
    recurse = true

[branch]
    sort = -committerdate

[core]
    autocrlf = true
    ignorecase = true
