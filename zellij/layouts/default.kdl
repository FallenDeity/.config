layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                format_left   "{mode} #[fg=#89b4fa,bold]{session} {tabs}"
                format_center ""
                format_right  "{command_git_branch} #[fg=#6c7086]│ {datetime}"
                format_space  ""

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#6c7086]{char}"
                border_position "top"

                hide_frame_for_single_pane "true"

                mode_normal        "#[bg=#a6e3a1,fg=#181825,bold] NORMAL #[bg=#181825,fg=#a6e3a1] "
                mode_locked        "#[bg=#f38ba8,fg=#181825,bold] LOCKED #[bg=#181825,fg=#f38ba8] "
                mode_pane          "#[bg=#89b4fa,fg=#181825,bold] PANE #[bg=#181825,fg=#89b4fa] "
                mode_tab           "#[bg=#cba6f7,fg=#181825,bold] TAB #[bg=#181825,fg=#cba6f7] "
                mode_scroll        "#[bg=#f9e2af,fg=#181825,bold] SCROLL #[bg=#181825,fg=#f9e2af] "
                mode_search        "#[bg=#f9e2af,fg=#181825,bold] SEARCH #[bg=#181825,fg=#f9e2af] "
                mode_session       "#[bg=#fab387,fg=#181825,bold] SESSION #[bg=#181825,fg=#fab387] "
                mode_move          "#[bg=#fab387,fg=#181825,bold] MOVE #[bg=#181825,fg=#fab387] "
                mode_resize        "#[bg=#89dceb,fg=#181825,bold] RESIZE #[bg=#181825,fg=#89dceb] "
                mode_tmux          "#[bg=#fab387,fg=#181825,bold] TMUX #[bg=#181825,fg=#fab387] "

                tab_normal              "#[fg=#6c7086] {index} {name} "
                tab_normal_fullscreen   "#[fg=#6c7086] {index} {name} [] "
                tab_normal_sync         "#[fg=#6c7086] {index} {name} <> "

                tab_active              "#[bg=#313244,fg=#cdd6f4,bold] {index} {name} "
                tab_active_fullscreen   "#[bg=#313244,fg=#cdd6f4,bold] {index} {name} [] "
                tab_active_sync         "#[bg=#313244,fg=#cdd6f4,bold] {index} {name} <> "

                tab_separator           "#[fg=#45475a]│"

                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=#89b4fa,bold] {stdout} "
                command_git_branch_interval    "5"
                command_git_branch_rendermode  "static"

                datetime          "#[fg=#cdd6f4,bold]{format}"
                datetime_format   "%H:%M %d-%b-%y"
                datetime_timezone "Asia/Kolkata"
            }
        }
    }
}
